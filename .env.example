# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-insert-capable-key

# Groq LLM enrichment (required to enable Step 3.5)
# Never commit a real key. Store it as the GROQ_API_KEY GitHub Actions secret.
GROQ_API_KEY=

# Optional OpenAI-compatible Ollama fallback, for example:
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=

# Logging: debug | info | warn | error
LOG_LEVEL=info
