# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-insert-capable-key

# LLM provider mode: auto (Groq then Ollama), groq, or ollama
LLM_PROVIDER=auto

# Groq primary provider
# Never commit a real key. Store it as the GROQ_API_KEY GitHub Actions secret.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_MS=2000

# Optional OpenAI-compatible Ollama provider/fallback, for example:
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=
# Optional Bearer token for an authenticated OpenAI-compatible gateway.
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b

# Shared LLM request controls
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_ATTEMPTS=3
LLM_MAX_RETRY_DELAY_MS=30000
LLM_MAX_COMPLETION_TOKENS=300
# Only apply model classification when confidence_score >= this value.
LLM_MIN_CONFIDENCE=0.65

# Logging: debug | info | warn | error
LOG_LEVEL=info
